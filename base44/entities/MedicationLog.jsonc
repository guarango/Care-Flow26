{
  "name": "MedicationLog",
  "type": "object",
  "properties": {
    "medication_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "medication_name": {
      "type": "string"
    },
    "administered_by": {
      "type": "string"
    },
    "administered_by_name": {
      "type": "string"
    },
    "staff_initials": {
      "type": "string",
      "description": "Staff initials for eMAR record"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Administered",
        "Refused",
        "Held",
        "Not Available",
        "Missed",
        "Error"
      ],
      "default": "Administered"
    },
    "self_administered": {
      "type": "boolean",
      "default": false,
      "description": "Client self-administered (vs. staff-administered)"
    },
    "error_description": {
      "type": "string",
      "description": "Required if status is Error \u2014 describe the error and any adverse effects"
    },
    "prn_reason": {
      "type": "string",
      "description": "If PRN medication: reason for administration and observed response"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "medication_id",
    "client_id",
    "date",
    "status"
  ]
}